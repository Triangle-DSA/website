---
export const prerender = true;

import { sanityClient } from "sanity:client";
import PortableText from "../components/PortableText.astro";
import Layout from "../layouts/Layout.astro";
import { urlForImage } from "../sanity/lib/url-for-image";
import type { Candidate } from "../sanity/schemaTypes/candidate";
import type { EndorsementsPage } from "../sanity/schemaTypes/endorsementsPage";

const endorsementsPage = await sanityClient.fetch<EndorsementsPage>(
  `*[_type == "endorsementsPage"][0]{
    title,
    description,
    currentlyEndorsedHeading,
    seekingHeading,
    seekingDescription,
    notesHeading,
    notes,
    questionnaireLabel,
    questionnaireUrl
  }`,
);

const candidates = await sanityClient.fetch<Candidate[]>(
  `*[_type == "candidate"] | order(order asc) {
    name,
    office,
    image,
    summary,
    order
  }`,
);
---

<Layout
  title={endorsementsPage?.title || "Endorsements - North Carolina DSA"}
  description={endorsementsPage?.description
  || "Learn about NC Triangle DSA's currently endorsed candidates and how to seek chapter endorsement."}
>
  <main id="main-content">
    <section class="section">
      <div class="container">
        <h2 class="section-heading">
          {endorsementsPage?.currentlyEndorsedHeading || "Currently Endorsed"}
        </h2>

        <div class="endorsee-list">
          {candidates && candidates.map((candidate) => {
            const imageUrl = candidate.image?.asset
              ? urlForImage(candidate.image).width(400).height(500).auto("format").fit(
                "crop",
              ).url()
              : null;
            return (
              <article class="endorsee-card">
                <div class="endorsee-media">
                  {imageUrl && (
                    <img
                      src={imageUrl}
                      alt={candidate.image.alt || `${candidate.name} campaign photo`}
                      loading="lazy"
                      class="endorsee-image"
                      width={400}
                      height={500}
                    />
                  )}
                </div>

                <div class="endorsee-content">
                  <h3>{candidate.name}</h3>
                  <p class="endorsee-office">{candidate.office}</p>
                  <p>{candidate.summary}</p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section bg-light">
      <div class="container container--narrow">
        <h2 class="section-heading">
          {endorsementsPage?.seekingHeading || "Seeking Endorsement?"}
        </h2>
        {endorsementsPage?.seekingDescription && (
          <div class="seeking-description-wrap">
            <PortableText portableText={endorsementsPage.seekingDescription} />
          </div>
        )}

        {endorsementsPage?.notes && (
          <div class="candidate-notes">
            <h3>
              {endorsementsPage.notesHeading || "What we look for in aspiring endorsees"}
            </h3>
            <ul>
              {endorsementsPage.notes.map((note) => <li>{note}</li>)}
            </ul>
          </div>
        )}

        {endorsementsPage?.questionnaireUrl && (
          <a
            href={endorsementsPage.questionnaireUrl}
            class="questionnaire-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {endorsementsPage.questionnaireLabel || "Submit Endorsement Questionnaire"}
          </a>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
.page-hero {
  background: linear-gradient(
    160deg,
    var(--gray-700) 0%,
    var(--gray-900) 60%,
    var(--black-rich) 100%
  );
  color: var(--white);
  padding: var(--space-3xl) 0;
  text-align: center;
}

.section-heading::after {
  background: var(--gray-700);
}

.page-hero h1 {
  color: var(--white);
}

.page-hero-sub {
  color: rgba(255, 255, 255, 0.92);
  margin: 0 auto;
}

.endorsee-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-xl);
}

.endorsee-card {
  display: flex;
  flex-direction: column;
  flex: 0 1 320px;
  max-width: 100%;
  min-width: 0;
  background: var(--white);
  border: 1px solid var(--gray-200);
  box-shadow: var(--shadow-sm);
}

.endorsee-media {
  width: 100%;
  max-width: 320px;
  height: 400px;
  overflow: hidden;
  flex-shrink: 0;
}

.endorsee-image {
  width: 100%;
  max-width: 320px;
  height: 400px;
  object-fit: cover;
  display: block;
}

.endorsee-content {
  flex: 1;
  min-width: 0;
  padding: var(--space-lg);
  overflow-wrap: break-word;
}

.endorsee-office {
  font-size: var(--text-sm);
  font-weight: 700;
  letter-spacing: 0.04em;

  color: var(--text-secondary);
  margin-bottom: var(--space-md);
}

.candidate-notes {
  margin: var(--space-xl) 0;
  background: var(--white);
  padding: var(--space-lg);
  border: 1px solid var(--gray-200);
  border-left: 1px solid var(--gray-200);
  box-shadow: var(--shadow-sm);
}

.candidate-notes ul {
  padding-left: 1.25rem;
}

.candidate-notes li {
  margin-bottom: var(--space-sm);
}

.questionnaire-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-sm) var(--space-xl);
  font-family: var(--font-display);
  font-size: var(--text-lg);
  letter-spacing: 0.08em;

  background: var(--gray-900);
  color: var(--white);
  text-decoration: none;
}

.questionnaire-link:hover {
  color: var(--white);
  background: var(--black-rich);
  text-decoration: none;
}

@media (max-width: 768px) {
  .page-hero {
    padding: var(--space-2xl) 0;
  }

  .endorsee-list {
    flex-direction: column;
    align-items: center;
  }

  .endorsee-card {
    width: 100%;
  }

  .endorsee-media,
  .endorsee-image {
    max-width: 100%;
    height: auto;
  }
}
</style>
