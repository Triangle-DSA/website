---
export const prerender = true;

import { sanityClient } from "sanity:client";
import PageHero from "../components/PageHero.astro";
import PortableText from "../components/PortableText.astro";
import SanityImage from "../components/SanityImage.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ZineCard from "../components/ZineCard.astro";
import Layout from "../layouts/Layout.astro";
import type { Candidate } from "../sanity/schemaTypes/candidate";
import type { EndorsementsPage } from "../sanity/schemaTypes/endorsementsPage";

const endorsementsPage = await sanityClient.fetch<EndorsementsPage>(
  `*[_type == "endorsementsPage"][0]{
    title,
    description,
    currentlyEndorsedHeading,
    seekingHeading,
    seekingDescription,
    notesHeading,
    notes,
    questionnaireLabel,
    questionnaireUrl
  }`,
);

const candidates = await sanityClient.fetch<Candidate[]>(
  `*[_type == "candidate"] | order(order asc) {
    name,
    office,
    image,
    summary,
    order
  }`,
);
---

<Layout
  title={endorsementsPage?.title || "Endorsements - North Carolina DSA"}
  description={endorsementsPage?.description
  || "Learn about NC Triangle DSA's currently endorsed candidates and how to seek chapter endorsement."}
>
  <main id="main-content">
    <PageHero
      title={endorsementsPage?.title || "Endorsements"}
      subtitle={endorsementsPage?.description
      || "Learn about our currently endorsed candidates and how to seek chapter endorsement."}
      rotate="-rotate-1"
      subtitleRotate="rotate-1"
      tapes={["top: -10px; left: 50%; transform: translateX(-50%) rotate(2deg); width: 200px"]}
    />

    <section class="section container my-xl">
      <SectionHeader
        title={endorsementsPage?.currentlyEndorsedHeading || "Currently Endorsed"}
        bgColor="pink"
        class="mb-xl"
      />

      <div class="endorsee-list">
        {candidates && candidates.map((candidate, i) => {
          const rotateClass = i % 2 === 0 ? "rotate-1" : "-rotate-1";
          const mediaRotateClass = i % 2 === 0 ? "-rotate-1" : "rotate-1";

          return (
            <div class="endorsee-item flex flex-col">
              <div class={`endorsee-media-container relative ${mediaRotateClass}`}>
                <div
                  class="tape-effect"
                  style={`top: -15px; left: 50%; transform: translateX(-50%) rotate(${
                    i % 2 === 0 ? "-5deg" : "5deg"
                  }); width: 100px;`}
                >
                </div>
                <div class="endorsee-media">
                  {candidate.image?.asset && (
                    <SanityImage
                      src={candidate.image}
                      alt={candidate.name}
                      loading="lazy"
                      class="endorsee-image"
                      pictureClass="w-full h-full object-cover block"
                      width={400}
                      height={400}
                      fit="crop"
                    />
                  )}
                </div>
              </div>

              <ZineCard
                as="article"
                variant="lowest"
                border="heavy"
                shadow="solid"
                class="endorsee-card flex flex-col mt-md flex-grow"
                hover={false}
              >
                <div class="endorsee-content p-md flex flex-col justify-center h-full">
                  <h3 class="font-display candidate-name font-black uppercase mb-xs">
                    {candidate.name}
                  </h3>
                  <p class="font-typewriter text-lg font-bold text-on-surface-variant mb-sm">
                    {candidate.office}
                  </p>
                  <p class="font-typewriter text-md leading-relaxed">
                    {candidate.summary}
                  </p>
                </div>
              </ZineCard>
            </div>
          );
        })}
      </div>
    </section>

    <ZineCard
      as="section"
      variant="lowest"
      border="heavy"
      shadow="solid"
      class="container my-xl p-xl"
      hover={false}
    >
      <div class="absolute inset-0 bg-halftone-texture opacity-10 pointer-events-none">
      </div>

      <div class="relative z-10 max-w-4xl mx-auto">
        <SectionHeader
          title={endorsementsPage?.seekingHeading || "Seeking Endorsement?"}
          bgColor="yellow"
          class="mb-lg"
        />

        {endorsementsPage?.seekingDescription && (
          <div class="seeking-description-wrap font-typewriter text-xl leading-relaxed space-y-md mb-xl">
            <PortableText portableText={endorsementsPage.seekingDescription} />
          </div>
        )}

        {endorsementsPage?.notes && (
          <div class="candidate-notes bg-on-background text-on-primary p-lg border-medium border-on-primary candidate-notes-shadow mb-xl relative">
            <div
              class="tape-effect"
              style="top: -15px; right: 20px; transform: rotate(10deg)"
            >
            </div>
            <h3 class="font-display candidate-notes-title uppercase mb-md text-accent-yellow">
              {endorsementsPage.notesHeading || "What we look for in aspiring endorsees"}
            </h3>
            <ul class="font-typewriter text-lg space-y-sm pl-md list-disc list-outside">
              {endorsementsPage.notes.map((note) => <li>{note}</li>)}
            </ul>
          </div>
        )}

        {endorsementsPage?.questionnaireUrl && (
          <div class="text-center mt-xl">
            <a
              href={endorsementsPage.questionnaireUrl}
              class="questionnaire-link inline-block font-button text-2xl uppercase bg-primary text-on-primary py-md px-xl border-heavy solid-shadow hover:scale-105 active:scale-95 transition-transform rotate-2"
              target="_blank"
              rel="noopener noreferrer"
            >
              {endorsementsPage.questionnaireLabel || "Submit Endorsement Questionnaire"}
            </a>
          </div>
        )}
      </div>
    </ZineCard>
  </main>
</Layout>

<style>
/* Grid / List Layouts */
.endorsee-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-xl);
}

.endorsee-item {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.endorsee-media-container {
  z-index: 10;
  margin-bottom: var(--space-xs);
  width: 100%;
}

.endorsee-media {
  border: 4px solid var(--color-on-background);
  background-color: #ffffff;
  padding: 12px 12px 28px 12px;
  position: relative;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  width: 100%;
}

.endorsee-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.endorsee-card {
  overflow: visible;
  transition: all var(--transition-normal);
  width: 100%;
}

.endorsee-item:hover .endorsee-card {
  background-color: var(--color-accent-yellow);
  transform: translateY(-8px);
  box-shadow: 12px 12px 0px 0px var(--color-on-background);
}

@media (min-width: 768px) {
  .endorsee-list {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-gutter);
  }
}

.candidate-name {
  font-size: clamp(24px, 3vw, 28px);
}
.candidate-notes-shadow {
  box-shadow: 8px 8px 0px 0px var(--color-primary);
}
.candidate-notes-title {
  font-size: 28px;
}
</style>
