---
import CalendarEmbed from "../components/CalendarEmbed";
import PageHero from "../components/PageHero.astro";
import ZineCard from "../components/ZineCard.astro";
import Layout from "../layouts/Layout.astro";

const icalFeedUrl = import.meta.env.PUBLIC_ICAL_FEED_URL;
const hasCalendarFeed = Boolean(icalFeedUrl);
const subscribeUrl = icalFeedUrl?.replace(/^https?:\/\//, "webcal://") ?? "";
const calendarDataUrl = "/api/calendar.ics";
---

<Layout
  title="Calendar - North Carolina DSA"
  description="Upcoming events, meetings, and actions from the North Carolina Democratic Socialists of America"
>
  <main id="main-content">
    <!-- Page Hero -->
    <PageHero
      title="Upcoming Events"
      subtitle="Join us for meetings, actions, social events, and more!"
      rotate="rotate-1"
      subtitleRotate="-rotate-1"
      tapes={[
        "top: -10px; left: 20%; transform: translateX(-50%) rotate(5deg)",
        "top: -10px; left: 80%; transform: translateX(-50%) rotate(-3deg)",
      ]}
    />

    <section class="section container">
      <div class="content-wrapper">
        {!hasCalendarFeed && (
          <ZineCard
            variant="yellow"
            border="heavy"
            shadow="solid"
            rotate="rotate-1"
            class="mb-xl p-lg flex items-center gap-md"
            role="alert"
            hover={false}
          >
            <svg
              class="notice-icon text-on-background"
              width="24"
              height="24"
              viewBox="0 0 18 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="9" cy="9" r="7.5" />
              <path d="M9 5.5v4M9 12.5h.01" />
            </svg>
            <p class="font-typewriter text-lg text-on-background">
              <strong>Note:</strong> Calendar feed is not configured. Set
              <code class="bg-surface-lowest px-2 py-1 border-medium"
              >PUBLIC_ICAL_FEED_URL</code> in your environment to show events.
            </p>
          </ZineCard>
        )}

        {hasCalendarFeed ? (
          <ZineCard
            variant="lowest"
            border="heavy"
            shadow="solid"
            class="calendar-wrapper mb-xl p-lg relative"
            hover={false}
            tape="top: -10px; left: 50%; transform: translateX(-50%) rotate(2deg)"
          >
            <CalendarEmbed icalUrl={calendarDataUrl} client:load />
          </ZineCard>
        ) : (
           <ZineCard
             variant="lowest"
             border="heavy"
             shadow="solid"
             class="no-events mb-xl p-xl text-center"
             hover={false}
           >
             <p class="font-typewriter text-xl text-on-background">
               No calendar feed is available right now. Check back soon or
               follow us on social media for announcements.
             </p>
           </ZineCard>
         )}

        <ZineCard
          variant="surface"
          border="heavy"
          shadow="solid"
          class="calendar-info p-xl relative mt-xl"
          hover={false}
        >
          <h2 class="font-display info-title text-on-background uppercase mb-sm bg-accent-pink inline-block px-2 border-medium shadow-md -rotate-1">
            Stay Updated
          </h2>
          <p class="font-typewriter text-lg text-on-background mb-md">
            Don't miss an event! Here are ways to stay in the loop:
          </p>
          <ul class="info-list font-typewriter text-lg text-on-background">
            <li class="flex items-center gap-sm mb-sm hover:translate-x-2 transition-transform">
              <span class="bg-on-background p-1 border-medium">
                <svg
                  class="info-icon text-primary"
                  width="20"
                  height="20"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect x="2" y="3" width="12" height="11" rx="2" />
                  <path d="M2 6h12M5.5 1v3M10.5 1v3" />
                </svg>
              </span>
              <a href="/#contact" class="hover-underline text-primary font-bold"
              >Sign up for our email list</a>
            </li>
            <li class="flex items-center gap-sm hover:translate-x-2 transition-transform">
              <span class="bg-on-background p-1 border-medium">
                <svg
                  class="info-icon text-primary"
                  width="20"
                  height="20"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="8" cy="8" r="6" />
                  <path d="M8 4v4l3 2" />
                </svg>
              </span>
              {hasCalendarFeed ? (
                <a
                  href={subscribeUrl}
                  class="hover-underline text-primary font-bold"
                >Subscribe to our calendar</a>
              ) : <span>Calendar subscription available soon</span>}
            </li>
          </ul>
        </ZineCard>
      </div>
    </section>
  </main>
</Layout>

<style>
.info-title {
  font-size: 32px;
}

.hover-underline:hover {
  text-decoration: underline;
  color: var(--color-on-background);
  background-color: var(--color-accent-yellow);
}

/* Specifics */
.calendar-wrapper :global(.fc) {
  font-family: var(--font-typewriter);
}

.calendar-wrapper :global(.fc .fc-button) {
  background: var(--color-primary);
  border: 3px solid var(--color-on-background);
  color: var(--color-on-primary);
  font-weight: 700;
  border-radius: 0;
  text-transform: uppercase;
  transition: all var(--transition-fast);
}

.calendar-wrapper :global(.fc .fc-button:hover),
.calendar-wrapper :global(.fc .fc-button:focus) {
  background: var(--color-accent-yellow);
  color: var(--color-on-background);
  transform: scale(1.05);
}

.calendar-wrapper
  :global(.fc .fc-button-primary:not(:disabled).fc-button-active) {
  background: var(--color-on-background);
  color: var(--color-surface-lowest);
  border-color: var(--color-on-background);
}

.calendar-wrapper :global(.fc .fc-daygrid-event),
.calendar-wrapper :global(.fc .fc-list-event-title a) {
  color: var(--color-on-background);
  font-weight: 700;
}

.calendar-wrapper :global(.fc .fc-daygrid-event),
.calendar-wrapper :global(.fc .fc-list-event) {
  cursor: pointer;
}

/* Modal styles overrides for Zine Style */
.calendar-wrapper :global(.calendar-modal-backdrop) {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg);
  background: rgba(0, 0, 0, 0.85); /* Darker backdrop */
}

.calendar-wrapper :global(.calendar-modal) {
  position: relative;
  width: min(680px, 100%);
  max-height: min(85vh, 860px);
  overflow: auto;
  background: var(--color-surface-lowest);
  color: var(--color-on-background);
  border: 4px solid var(--color-on-background);
  box-shadow: var(--shadow-solid-lg);
  padding: var(--space-xl);
}

.calendar-wrapper :global(.calendar-modal-close) {
  position: absolute;
  top: var(--space-sm);
  right: var(--space-sm);
  width: 2rem;
  height: 2rem;
  border: 3px solid transparent;
  background: transparent;
  color: var(--color-on-background);
  font-size: 1.75rem;
  line-height: 1;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.calendar-wrapper :global(.calendar-modal-close:hover) {
  background: var(--color-accent-pink);
  border-color: var(--color-on-background);
}

.calendar-wrapper :global(.calendar-modal-title) {
  margin: 0 2.25rem var(--space-md) 0;
  color: var(--color-on-background);
  font-size: clamp(var(--text-xl), 2vw, var(--text-2xl));
  line-height: 1.1;
  font-family: var(--font-display);
  font-weight: 900;
  text-transform: uppercase;
}

.calendar-wrapper :global(.calendar-modal-meta) {
  margin: 0 0 var(--space-sm);
  color: var(--color-on-surface-variant);
  font-family: var(--font-typewriter);
  font-weight: 700;
}

.calendar-wrapper :global(.calendar-modal-meta strong) {
  color: var(--color-on-background);
}

.calendar-wrapper :global(.calendar-modal-description) {
  margin-top: var(--space-lg);
  font-family: var(--font-typewriter);
  font-size: 18px;
  border-top: 3px dashed var(--color-on-background);
  padding-top: var(--space-md);
}

.calendar-wrapper :global(.calendar-modal-description p) {
  margin: 0 0 var(--space-md);
  max-width: none;
  white-space: pre-wrap;
  color: var(--color-on-background);
}

.calendar-wrapper :global(.calendar-modal-actions) {
  margin-top: var(--space-lg);
  margin-bottom: 0;
}

@media (max-width: 768px) {
  .calendar-wrapper :global(.calendar-modal-backdrop) {
    padding: var(--space-md);
  }
  .calendar-wrapper :global(.calendar-modal) {
    padding: var(--space-lg);
  }
}
</style>
