---
import Layout from "../../layouts/Layout.astro";
import { loadQuery } from "../../sanity/lib/load-query";

interface PostListItem {
  title: string;
  slug: {
    current: string;
  };
  publishedAt?: string;
  mainImage?: {
    alt?: string;
    asset?: {
      url?: string;
    };
  };
}

const { data: posts } = await loadQuery<PostListItem[]>({
  query: `*[_type == "post" && defined(slug.current)]
    | order(coalesce(publishedAt, _createdAt) desc){
      title,
      slug,
      publishedAt,
      mainImage {
        alt,
        asset->{url}
      }
    }`,
});

function cardSize(i: number): "large" | "wide" | "small" {
  if (i === 0 || (i % 9 === 0 && i > 0)) return "large";
  if (i % 5 === 4) return "wide";
  return "small";
}
---

<Layout title="Left Angles | North Carolina DSA">
  <main id="main-content">
    <section class="page-hero bg-primary border-heavy solid-shadow mt-xl mb-xl mx-auto container relative -rotate-1">
      <div class="bg-dots mix-blend-multiply opacity-20 absolute inset-0 pointer-events-none">
      </div>
      <div
        class="tape-effect"
        style="top: -10px; left: 50%; transform: translateX(-50%) rotate(2deg); width: 200px"
      >
      </div>

      <div class="page-hero-content relative z-10 text-center py-xl px-lg">
        <h1 class="page-hero-title uppercase text-on-primary">Left Angles</h1>
        <p class="font-typewriter text-lg text-on-primary mt-md font-bold bg-on-background p-4 border-medium border-on-primary inline-block rotate-1 page-hero-sub">
          News, analysis, and dispatches from NC Triangle DSA
        </p>
      </div>
    </section>

    <section class="section container my-xl">
      <div class="posts-grid">
        {posts.map((post, i) => {
          const size = cardSize(i);
          const rotateClass = i % 2 === 0 ? "rotate-1" : "-rotate-1";
          return (
            <article
              class:list={[
                "post-card bg-surface-lowest border-heavy solid-shadow flex flex-col group transition-all duration-300 relative",
                size === "large" && "post-card--large",
                size === "wide" && "post-card--wide",
                rotateClass,
              ]}
            >
              <div
                class="tape-effect"
                style={`top: -10px; left: ${
                  i % 2 === 0 ? "10%" : "80%"
                }; transform: translateX(-50%) rotate(${i % 2 === 0 ? "-5deg" : "5deg"});`}
              >
              </div>

              <a
                href={`/leftangles/${post.slug.current}`}
                class="post-link flex flex-col h-full hover:no-underline"
              >
                {post.mainImage?.asset?.url ? (
                  <div class="post-image-container relative border-b-[4px] border-on-background overflow-hidden flex-shrink-0 bg-surface">
                    <img
                      class="post-image w-full h-full object-cover grayscale-filter transition-transform duration-300 group-hover:scale-105"
                      src={post.mainImage.asset.url}
                      alt={post.mainImage.alt ?? post.title}
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                      style={`view-transition-name: post-image-${post.slug.current}`}
                    />
                    <div class="absolute inset-0 bg-primary-fixed opacity-20 mix-blend-multiply pointer-events-none group-hover:opacity-0 transition-opacity duration-300">
                    </div>
                  </div>
                ) : (
                   <div
                     class="post-image-placeholder relative border-b-[4px] border-on-background flex-shrink-0 bg-accent-yellow"
                     aria-hidden="true"
                     style={`view-transition-name: post-image-${post.slug.current}`}
                   >
                     <div class="absolute inset-0 bg-halftone-texture opacity-30">
                     </div>
                   </div>
                 )}

                <div class="post-content p-lg flex-grow flex flex-col justify-center bg-surface group-hover:bg-accent-yellow transition-colors duration-300 relative">
                  <h2 class="font-display post-card-title font-black uppercase text-on-background mb-xs leading-tight group-hover:text-primary transition-colors">
                    {post.title}
                  </h2>
                  {post.publishedAt && (
                    <time
                      class="font-typewriter text-sm font-bold text-on-surface-variant mb-sm"
                      datetime={post.publishedAt}
                    >
                      {new Date(post.publishedAt).toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </time>
                  )}
                  <span
                    class="post-arrow absolute right-lg top-1/2 -translate-y-1/2 font-display text-2xl text-primary font-black opacity-0 -translate-x-4 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0"
                    aria-hidden="true"
                  >→</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
/* Layout Utilities */
.mx-auto {
  margin-left: auto;
  margin-right: auto;
}
.my-xl {
  margin-top: var(--space-xl);
  margin-bottom: var(--space-xl);
}
.mt-xl {
  margin-top: var(--space-xl);
}
.mb-xl {
  margin-bottom: var(--space-xl);
}
.mt-md {
  margin-top: var(--space-md);
}
.mb-xs {
  margin-bottom: var(--space-xs);
}
.mb-sm {
  margin-bottom: var(--space-sm);
}
.py-xl {
  padding-top: var(--space-xl);
  padding-bottom: var(--space-xl);
}
.px-lg {
  padding-left: var(--space-lg);
  padding-right: var(--space-lg);
}
.p-lg {
  padding: var(--space-lg);
}
.p-4 {
  padding: 16px;
}

/* Flexbox */
.flex {
  display: flex;
}
.flex-col {
  flex-direction: column;
}
.flex-grow {
  flex-grow: 1;
}
.flex-shrink-0 {
  flex-shrink: 0;
}
.justify-center {
  justify-content: center;
}

/* Misc */
.text-center {
  text-align: center;
}
.inline-block {
  display: inline-block;
}
.relative {
  position: relative;
}
.absolute {
  position: absolute;
}
.inset-0 {
  inset: 0;
}
.z-10 {
  z-index: 10;
}
.pointer-events-none {
  pointer-events: none;
}
.overflow-hidden {
  overflow: hidden;
}
.w-full {
  width: 100%;
}
.h-full {
  height: 100%;
}
.object-cover {
  object-fit: cover;
}
.uppercase {
  text-transform: uppercase;
}
.hover\:no-underline:hover {
  text-decoration: none;
}

.page-hero-title {
  font-family: var(--font-display);
  font-size: clamp(32px, 5vw, 64px);
  font-weight: 900;
  -webkit-text-stroke: 2px var(--color-on-background);
}
.page-hero-sub {
  box-shadow: 4px 4px 0px 0px #ffffff;
}
.post-card-title {
  font-size: 24px;
}
@media (min-width: 768px) {
  .post-card-title {
    font-size: 28px;
  }
}

/* Typography */
.font-display {
  font-family: var(--font-display);
}
.font-typewriter {
  font-family: var(--font-typewriter);
}
.font-black {
  font-weight: 900;
}
.font-bold {
  font-weight: 700;
}
.text-sm {
  font-size: 14px;
}
.text-lg {
  font-size: 18px;
}
.text-2xl {
  font-size: 24px;
}
.text-on-primary {
  color: var(--color-on-primary);
}
.text-on-background {
  color: var(--color-on-background);
}
.text-primary {
  color: var(--color-primary);
}
.text-on-surface-variant {
  color: var(--color-on-surface-variant);
}
.leading-tight {
  line-height: 1.1;
}

/* Colors & Blends */
.bg-primary {
  background-color: var(--color-primary);
}
.bg-on-background {
  background-color: var(--color-on-background);
}
.bg-surface-lowest {
  background-color: var(--color-surface-lowest);
}
.bg-surface {
  background-color: var(--color-surface);
}
.bg-accent-yellow {
  background-color: var(--color-accent-yellow);
}
.bg-primary-fixed {
  background-color: var(--color-primary-fixed);
}
.mix-blend-multiply {
  mix-blend-mode: multiply;
}
.opacity-20 {
  opacity: 0.2;
}
.opacity-30 {
  opacity: 0.3;
}

/* Borders & Shadows */
.border-medium {
  border: 3px solid var(--color-on-background);
}
.border-on-primary {
  border-color: var(--color-on-primary);
}
.border-on-background {
  border-color: var(--color-on-background);
}
.border-b-\[4px\] {
  border-bottom-width: 4px;
  border-bottom-style: solid;
}

/* Transitions & Transforms & Hover Effects */
.rotate-1 {
  transform: rotate(1deg);
}
.-rotate-1 {
  transform: rotate(-1deg);
}
.rotate-2 {
  transform: rotate(2deg);
}
.transition-all {
  transition: all var(--transition-normal);
}
.transition-colors {
  transition:
    background-color var(--transition-normal),
    color var(--transition-normal);
}
.transition-transform {
  transition: transform var(--transition-normal);
}
.transition-opacity {
  transition: opacity var(--transition-normal);
}
.duration-300 {
  transition-duration: 300ms;
}

.post-card:hover {
  transform: translateY(-8px);
}

.grayscale-filter {
  filter: grayscale(100%) contrast(1.1);
}
.post-card:hover .grayscale-filter {
  filter: grayscale(0%) contrast(1);
}

/* Grid System */
.posts-grid {
  display: grid;
  grid-template-columns: 1fr;
  grid-auto-rows: 320px;
  grid-auto-flow: dense;
  gap: var(--space-xl);
}

.post-image-container,
.post-image-placeholder {
  height: 180px;
}

/* Large card: 2 cols x 2 rows */
.post-card--large {
  grid-column: span 1;
  grid-row: span 2;
}
.post-card--large .post-image-container,
.post-card--large .post-image-placeholder {
  height: calc(100% - 140px); /* Fill available space minus content height */
  min-height: 240px;
}
.post-card--large .font-display {
  font-size: 32px;
}

/* Wide card: 2 cols x 1 row */
.post-card--wide {
  grid-column: span 1;
}

@media (min-width: 768px) {
  .posts-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .post-card--large, .post-card--wide {
    grid-column: span 2;
  }
  .post-card--large .font-display {
    font-size: 40px;
  }

  .post-card--wide .post-link {
    flex-direction: row;
  }
  .post-card--wide .post-image-container,
  .post-card--wide .post-image-placeholder {
    height: 100%;
    width: 40%;
    border-bottom-width: 0;
    border-right-width: 4px;
    border-right-style: solid;
    border-color: var(--color-on-background);
  }
}

@media (min-width: 1024px) {
  .posts-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>
