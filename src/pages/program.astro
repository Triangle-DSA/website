---
import { sanityClient } from "sanity:client";
import PageHero from "../components/PageHero.astro";
import ZineCard from "../components/ZineCard.astro";
import Layout from "../layouts/Layout.astro";
import { type ProgramItem } from "../sanity/schemaTypes/programItem";
import { slugify } from "../utils/slugify";

const sortedProgram = await sanityClient.fetch<ProgramItem[]>(
  `*[_type == "programItem"] | order(order asc) {
    title,
    icon,
    description,
    order
  }`,
);
---

<Layout
  title="Our Program - North Carolina DSA"
  description="NC Triangle DSA demands a democratic, socialist future. Read about our key political and economic program items."
>
  <main id="main-content">
    <!-- Page Hero -->
    <PageHero
      title="Our Program"
      subtitle="Demanding a democratic, socialist future in the Tar Heel State"
      rotate="-rotate-1"
      subtitleRotate="rotate-1"
      tapes={["top: -10px; left: 50%; transform: translateX(-50%) rotate(2deg); width: 200px"]}
    />

    <!-- Program Content Section -->
    <section class="section container my-xl">
      <div class="program-container">
        <!-- Sidebar Table of Contents -->
        <aside class="program-sidebar">
          <ZineCard
            as="nav"
            aria-label="Program sections navigation"
            variant="surface"
            border="heavy"
            shadow="solid"
            class="sticky-nav p-md"
            hover={false}
          >
            <h2 class="font-display text-xl uppercase bg-accent-pink inline-block px-4 border-medium shadow-md -rotate-2 mb-md">
              Sections
            </h2>
            <ul class="sidebar-list flex flex-col gap-md font-typewriter font-bold">
              {sortedProgram.map((item, index) => {
                const itemRotate = index % 4 === 0
                  ? "rotate-1"
                  : index % 4 === 1
                  ? "-rotate-1"
                  : index % 4 === 2
                  ? "rotate-2"
                  : "-rotate-2";
                return (
                  <li class={itemRotate}>
                    <a
                      href={`#${slugify(item.title)}`}
                      class="sidebar-link flex items-center gap-sm p-2 border-medium border-transparent transition-all"
                    >
                      <span
                        class="sidebar-link-icon text-2xl"
                        aria-hidden="true"
                      >{item.icon}</span>
                      <span
                        class="sidebar-link-text text-lg uppercase leading-tight"
                      >{item.title}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </ZineCard>
        </aside>

        <!-- Main Content -->
        <div class="program-content flex flex-col">
          {sortedProgram.map((item, i) => {
            const slug = slugify(item.title);
            const rotateClass = i % 2 === 0 ? "-rotate-1" : "rotate-1";
            const variant = i % 3 === 0
              ? "lowest"
              : i % 3 === 1
              ? "surface"
              : "primary-fixed-dim";
            const tapeRotate = i % 2 === 0 ? "-5deg" : "5deg";
            const tapeLeft = i % 2 === 0 ? "10%" : "auto";
            const tapeRight = i % 2 === 0 ? "auto" : "10%";

            return (
              <ZineCard
                as="article"
                id={slug}
                variant={variant}
                border="heavy"
                shadow="solid"
                class="program-section p-lg"
                hover={false}
                tape={`top: -15px; left: ${tapeLeft}; right: ${tapeRight}; transform: rotate(${tapeRotate}); width: 120px;`}
              >
                <h2 class="section-title font-display uppercase font-black mb-md pb-xs border-b-4 border-on-background flex items-center gap-md">
                  <span
                    class="section-title-icon text-4xl"
                    aria-hidden="true"
                  >{item.icon}</span>
                  {item.title}
                </h2>
                <div class="section-body font-typewriter text-lg leading-relaxed space-y-md">
                  {item.description.split("\n\n").filter(p => p.trim()).map((
                    paragraph,
                  ) => <p>{paragraph}</p>)}
                </div>
              </ZineCard>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
// Scroll spy to highlight active section in sidebar
const observerOptions = {
  root: null,
  rootMargin: "-20% 0px -60% 0px", // triggers when section is in the middle of the viewport
  threshold: 0,
};

const sections = document.querySelectorAll(".program-section");
const navLinks = document.querySelectorAll(".sidebar-link");

const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      const id = entry.target.getAttribute("id");
      navLinks.forEach((link) => {
        const href = link.getAttribute("href");
        if (href === `#${id}`) {
          link.classList.add("sidebar-link--active");
        } else {
          link.classList.remove("sidebar-link--active");
        }
      });
    }
  });
}, observerOptions);

sections.forEach((section) => observer.observe(section));
</script>

<style>
.program-container {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-xl);
  align-items: start;
}
@media (min-width: 1024px) {
  .program-container {
    grid-template-columns: 280px 1fr;
    gap: var(--space-2xl);
  }
}

/* Components */
.program-sidebar {
  position: sticky;
  top: 96px; /* offset for site header */
}

.sidebar-list {
  list-style: none;
}

.sidebar-link {
  color: var(--color-on-background);
  text-decoration: none;
}

.sidebar-link:hover {
  background-color: var(--color-accent-yellow);
  border-color: var(--color-on-background);
  transform: translateX(4px);
}

.sidebar-link--active {
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  border-color: var(--color-on-background);
  transform: translateX(4px);
}

.program-section {
  scroll-margin-top: 100px; /* target scroll offset for navbar */
}

.program-content {
  gap: var(--space-xl);
}
@media (min-width: 1024px) {
  .program-content {
    gap: var(--space-2xl);
  }
}

@media (min-width: 768px) {
  .p-lg {
    padding: var(--space-xl);
  }
}

@media (max-width: 1023px) {
  .program-sidebar {
    position: static;
    margin-bottom: var(--space-lg);
  }
  .sidebar-list li {
    transform: none;
  }
}
</style>
