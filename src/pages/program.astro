---
import { sanityClient } from "sanity:client";
import Layout from "../layouts/Layout.astro";
import { type ProgramItem } from "../sanity/schemaTypes/programItem";
import { slugify } from "../utils/slugify";

const sortedProgram = await sanityClient.fetch<ProgramItem[]>(
  `*[_type == "programItem"] | order(order asc) {
    title,
    icon,
    description,
    order
  }`,
);
---

<Layout
  title="Our Program - North Carolina DSA"
  description="NC Triangle DSA demands a democratic, socialist future. Read about our key political and economic program items."
>
  <main id="main-content">
    <!-- Page Hero -->
    <section class="page-hero bg-primary border-heavy solid-shadow mt-xl mb-xl mx-auto container relative -rotate-1">
      <div class="bg-dots mix-blend-multiply opacity-20 absolute inset-0 pointer-events-none">
      </div>
      <div class="tape-effect tape-top-center"></div>

      <div class="page-hero-content relative z-10 text-center py-xl px-lg">
        <h1 class="page-hero-title uppercase text-on-primary font-display font-black">
          Our Program
        </h1>
        <p class="font-typewriter text-lg text-on-primary mt-md font-bold bg-on-background p-4 border-medium border-on-primary inline-block rotate-1 shadow-hero-subtitle">
          Demanding a democratic, socialist future in the Tar Heel State
        </p>
      </div>
    </section>

    <!-- Program Content Section -->
    <section class="section container my-xl">
      <div class="program-container">
        <!-- Sidebar Table of Contents -->
        <aside class="program-sidebar">
          <nav
            aria-label="Program sections navigation"
            class="sticky-nav bg-surface border-heavy solid-shadow p-md rotate-1"
          >
            <h2 class="font-display text-xl uppercase bg-accent-pink inline-block px-4 border-medium shadow-md -rotate-2 mb-md">
              Sections
            </h2>
            <ul class="sidebar-list flex flex-col gap-sm font-typewriter font-bold">
              {sortedProgram.map((item) => (
                <li>
                  <a
                    href={`#${slugify(item.title)}`}
                    class="sidebar-link flex items-center gap-sm p-2 border-medium border-transparent transition-all"
                  >
                    <span
                      class="sidebar-link-icon text-2xl"
                      aria-hidden="true"
                    >{item.icon}</span>
                    <span
                      class="sidebar-link-text text-lg uppercase leading-tight"
                    >{item.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>

        <!-- Main Content -->
        <div class="program-content flex flex-col gap-xl">
          {sortedProgram.map((item, i) => {
            const slug = slugify(item.title);
            const rotateClass = i % 2 === 0 ? "-rotate-1" : "rotate-1";
            const bgClass = i % 3 === 0
              ? "bg-surface-lowest"
              : i % 3 === 1
              ? "bg-surface"
              : "bg-primary-fixed-dim";
            const tapeRotate = i % 2 === 0 ? "-5deg" : "5deg";
            const tapeLeft = i % 2 === 0 ? "10%" : "auto";
            const tapeRight = i % 2 === 0 ? "auto" : "10%";

            return (
              <article
                id={slug}
                class={`program-section ${bgClass} border-heavy solid-shadow p-lg relative ${rotateClass}`}
              >
                <div
                  class="tape-effect"
                  style={`top: -15px; left: ${tapeLeft}; right: ${tapeRight}; transform: rotate(${tapeRotate}); width: 120px;`}
                >
                </div>

                <h2 class="section-title font-display uppercase font-black mb-md pb-xs border-b-4 border-on-background flex items-center gap-md">
                  <span
                    class="section-title-icon text-4xl"
                    aria-hidden="true"
                  >{item.icon}</span>
                  {item.title}
                </h2>
                <div class="section-body font-typewriter text-lg leading-relaxed space-y-md">
                  {item.description.split("\n\n").filter(p => p.trim()).map((
                    paragraph,
                  ) => <p>{paragraph}</p>)}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
// Scroll spy to highlight active section in sidebar
const observerOptions = {
  root: null,
  rootMargin: "-20% 0px -60% 0px", // triggers when section is in the middle of the viewport
  threshold: 0,
};

const sections = document.querySelectorAll(".program-section");
const navLinks = document.querySelectorAll(".sidebar-link");

const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (entry.isIntersecting) {
      const id = entry.target.getAttribute("id");
      navLinks.forEach((link) => {
        const href = link.getAttribute("href");
        if (href === `#${id}`) {
          link.classList.add("sidebar-link--active");
        } else {
          link.classList.remove("sidebar-link--active");
        }
      });
    }
  });
}, observerOptions);

sections.forEach((section) => observer.observe(section));
</script>

<style>
/* Layout Utilities */
.mx-auto {
  margin-left: auto;
  margin-right: auto;
}
.my-xl {
  margin-top: var(--space-xl);
  margin-bottom: var(--space-xl);
}
.mt-xl {
  margin-top: var(--space-xl);
}
.mb-xl {
  margin-bottom: var(--space-xl);
}
.mt-md {
  margin-top: var(--space-md);
}
.mb-md {
  margin-bottom: var(--space-md);
}
.pb-xs {
  padding-bottom: var(--space-xs);
}
.py-xl {
  padding-top: var(--space-xl);
  padding-bottom: var(--space-xl);
}
.px-lg {
  padding-left: var(--space-lg);
  padding-right: var(--space-lg);
}
.p-lg {
  padding: var(--space-lg);
}
.p-md {
  padding: var(--space-md);
}
.p-4 {
  padding: 16px;
}
.px-4 {
  padding-left: 16px;
  padding-right: 16px;
}
.p-2 {
  padding: 8px;
}
.space-y-md > * + * {
  margin-top: var(--space-md);
}

/* Flex & Grid */
.flex {
  display: flex;
}
.flex-col {
  flex-direction: column;
}
.items-center {
  align-items: center;
}
.gap-xl {
  gap: var(--space-xl);
}
.gap-md {
  gap: var(--space-md);
}
.gap-sm {
  gap: var(--space-sm);
}
.inline-block {
  display: inline-block;
}

.program-container {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-xl);
  align-items: start;
}
@media (min-width: 1024px) {
  .program-container {
    grid-template-columns: 280px 1fr;
    gap: var(--space-2xl);
  }
}

/* Positioning & Z-index */
.relative {
  position: relative;
}
.absolute {
  position: absolute;
}
.inset-0 {
  inset: 0;
}
.z-10 {
  z-index: 10;
}
.pointer-events-none {
  pointer-events: none;
}
.text-center {
  text-align: center;
}

/* Transforms & Transitions */
.rotate-1 {
  transform: rotate(1deg);
}
.-rotate-1 {
  transform: rotate(-1deg);
}
.-rotate-2 {
  transform: rotate(-2deg);
}
.transition-all {
  transition: all var(--transition-fast) var(--ease-out);
}

.tape-top-center {
  top: -10px;
  left: 50%;
  transform: translateX(-50%) rotate(2deg);
  width: 200px;
}

/* Typography */
.uppercase {
  text-transform: uppercase;
}
.font-display {
  font-family: var(--font-display);
}
.font-typewriter {
  font-family: var(--font-typewriter);
}
.font-black {
  font-weight: 900;
}
.font-bold {
  font-weight: 700;
}
.text-lg {
  font-size: 18px;
}
.text-xl {
  font-size: 20px;
}
.text-2xl {
  font-size: 24px;
}
.text-4xl {
  font-size: 36px;
}
.leading-tight {
  line-height: 1.2;
}
.leading-relaxed {
  line-height: 1.625;
}

.page-hero-title {
  font-size: clamp(32px, 5vw, 64px);
  -webkit-text-stroke: 2px var(--color-on-background);
}

.section-title {
  font-size: clamp(24px, 4vw, 36px);
}

/* Colors & Backgrounds */
.bg-primary {
  background-color: var(--color-primary);
}
.bg-primary-fixed-dim {
  background-color: var(--color-primary-fixed-dim);
}
.bg-on-background {
  background-color: var(--color-on-background);
}
.bg-surface-lowest {
  background-color: var(--color-surface-lowest);
}
.bg-surface {
  background-color: var(--color-surface);
}
.bg-accent-yellow {
  background-color: var(--color-accent-yellow);
}
.bg-accent-pink {
  background-color: var(--color-accent-pink);
}
.text-on-primary {
  color: var(--color-on-primary);
}
.mix-blend-multiply {
  mix-blend-mode: multiply;
}
.opacity-20 {
  opacity: 0.2;
}

/* Borders & Shadows */
.border-medium {
  border: 3px solid var(--color-on-background);
}
.border-on-primary {
  border-color: var(--color-on-primary);
}
.border-on-background {
  border-color: var(--color-on-background);
}
.border-transparent {
  border-color: transparent;
}
.border-b-4 {
  border-bottom: 4px solid var(--color-on-background);
}
.shadow-md {
  box-shadow: var(--shadow-solid-md);
}
.shadow-hero-subtitle {
  box-shadow: 4px 4px 0px 0px #ffffff;
}

/* Components */
.program-sidebar {
  position: sticky;
  top: 96px; /* offset for site header */
}

.sidebar-link {
  color: var(--color-on-background);
  text-decoration: none;
}

.sidebar-link:hover {
  background-color: var(--color-accent-yellow);
  border-color: var(--color-on-background);
  transform: translateX(4px);
}

.sidebar-link--active {
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  border-color: var(--color-on-background);
  transform: translateX(4px);
}

.program-section {
  scroll-margin-top: 100px; /* target scroll offset for navbar */
}

@media (min-width: 768px) {
  .p-lg {
    padding: var(--space-xl);
  }
}

@media (max-width: 1023px) {
  .program-sidebar {
    position: static;
    margin-bottom: var(--space-lg);
  }
}
</style>
