---
import { sanityClient } from "sanity:client";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ZineCard from "../components/ZineCard.astro";
import Layout from "../layouts/Layout.astro";
import { urlForImage } from "../sanity/lib/url-for-image";
import { type Campaign } from "../sanity/schemaTypes/campaign";
import { type HomepageContent } from "../sanity/schemaTypes/homepageContent";
import { type ProgramItem } from "../sanity/schemaTypes/programItem";
import { type SocialMedia } from "../sanity/schemaTypes/socialMedia";
import { slugify } from "../utils/slugify";

const homepage = await sanityClient.fetch<HomepageContent>(
  `*[_type == "homepageContent"][0]{
      hero {
        title,
        subtitle,
        carousel[] {
          label,
          image {
            alt,
            asset
          }
        }
      },
      about,
      join
    }`,
);

const sortedProgram = await sanityClient.fetch<ProgramItem[]>(
  `*[_type == "programItem"] | order(order asc) {
    title,
    icon,
    description,
    order
  }`,
);

const sortedCampaigns = await sanityClient.fetch<Campaign[]>(
  `*[_type == "campaign"] | order(order asc) {
    title,
    description,
    order
  }`,
);

const socialMediaItems = await sanityClient.fetch<SocialMedia[]>(
  `*[_type == "socialMedia"] | order(order asc) {
    platform,
    label,
    url,
    emoji,
    order
  }`,
);
const heroPreloadUrl = homepage?.hero?.carousel?.[0]?.image?.asset
  ? urlForImage(homepage.hero.carousel[0].image).width(1920).auto("format")
    .url()
  : null;
---

<Layout title="North Carolina DSA - Democratic Socialists of America">
  {heroPreloadUrl && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={heroPreloadUrl}
      fetchpriority="high"
    />
  )}
  <Hero
    title={homepage?.hero?.title}
    subtitle={homepage?.hero?.subtitle}
    carousel={homepage?.hero?.carousel}
  />
  <main id="main-content">
    <!-- About Section -->
    <section id="about" class="about-section container mt-md relative">
      <SectionHeader
        title={homepage?.about?.heading}
        bgColor="pink"
        rotate="rotate-1"
      />
      <ZineCard
        variant="lowest"
        border="heavy"
        shadow="solid-lg"
        rotate="-rotate-1"
        class="about-content p-lg"
        hover={false}
      >
        <p class="about-lead">{homepage?.about?.paragraph1}</p>
        <p>{homepage?.about?.paragraph2}</p>
      </ZineCard>
    </section>

    <!-- Program Section -->
    <section
      id="program"
      class="program-section container mt-xl bg-surface-lowest relative"
    >
      <div class="bg-dots program-bg-overlay"></div>
      <SectionHeader
        title="Our Program"
        subtitle="-- Where the organizing happens. Join a working group today. --"
        bgColor="yellow"
        rotate="-rotate-1"
        subtitleRotate="rotate-1"
      />

      <div class="program-grid pt-md">
        {sortedProgram.map((item, i) => {
          const rotateClass = i % 3 === 0
            ? "-rotate-1"
            : i % 3 === 1
            ? "rotate-1"
            : "-rotate-2";
          const iconBgClass = i % 3 === 0
            ? "bg-primary-fixed"
            : i % 3 === 1
            ? "bg-accent-yellow"
            : "bg-primary-fixed-dim";
          const tapeRotateClass = i % 2 === 0 ? "rotate(-6deg)" : "rotate(5deg)";

          return (
            <ZineCard
              as="a"
              href={`/program#${slugify(item.title)}`}
              variant="lowest"
              border="heavy"
              shadow="solid"
              rotate={rotateClass}
              class="program-card p-sm group"
              tape={`transform: translateX(-50%) ${tapeRotateClass};`}
            >
              <div class="program-card-content z-10">
                <div
                  class={`program-icon shadow-md border-medium ${iconBgClass} ${
                    i % 3 === 2 ? "rounded-full" : ""
                  } ${rotateClass}`}
                >
                  <span class="icon-text">{item.icon}</span>
                </div>
                <h3 class="program-title uppercase">{item.title}</h3>
              </div>
            </ZineCard>
          );
        })}
      </div>
    </section>

    <!-- Campaigns Section -->
    <section
      id="campaigns"
      class="campaigns-section container my-xl bg-surface-lowest border-heavy solid-shadow relative rotate-1"
    >
      <div class="campaigns-bg-texture bg-halftone-texture"></div>
      <div class="campaigns-sticker font-typewriter uppercase">
        JOIN US! -&gt;
      </div>
      <div class="tape-effect tape-top-left"></div>
      <div class="tape-effect tape-top-right"></div>
      <div class="tape-effect tape-bottom-center"></div>

      <div class="campaigns-header">
        <h2 class="campaigns-title uppercase">
          <span class="highlighter-effect">Our Campaigns</span>
        </h2>
      </div>

      <div class="campaigns-grid">
        {sortedCampaigns.map((campaign, i) => {
          const rotateClass = i % 2 === 0 ? "-rotate-1" : "rotate-1";
          return (
            <ZineCard
              variant="surface"
              border="heavy"
              shadow="solid-lg"
              rotate={rotateClass}
              class="campaign-card p-md"
            >
              <div class="campaign-card-content">
                <h4 class="campaign-title uppercase">{campaign.title}</h4>
                <div class="campaign-desc font-typewriter">
                  <p>{campaign.description}</p>
                </div>
              </div>
            </ZineCard>
          );
        })}
      </div>
    </section>

    <!-- Join Section -->
    <section id="join" class="join-section container my-xl relative">
      <div class="join-banner bg-primary border-heavy solid-shadow -rotate-1">
        <div class="join-bg-dots bg-dots"></div>

        <div class="join-content">
          <h2 class="join-title uppercase -rotate-2">
            {homepage?.join?.heading || "Fund the Movement."}
          </h2>
          <p class="join-text font-typewriter shadow-md rotate-1">
            {homepage?.join?.text}
          </p>
          {homepage?.join?.duesInfo && (
            <p class="join-dues font-typewriter">
              * {homepage?.join?.duesInfo}
            </p>
          )}
        </div>

        <div class="join-actions">
          <a
            class="btn-primary join-cta shadow-solid rotate-3 uppercase"
            href="https://dsausa.org/join"
            target="_blank"
            rel="noopener noreferrer"
          >
            Join DSA
          </a>
          <a
            class="btn-secondary join-contact shadow-md -rotate-2 uppercase"
            href="#contact"
          >
            Contact NC Chapter
          </a>
        </div>
      </div>
    </section>

    <!-- Events Section CTA -->
    <section
      id="events"
      class="events-section bg-surface-lowest border-heavy solid-shadow rotate-1 my-xl relative"
    >
      <div class="tape-effect tape-events"></div>
      <div class="events-emoji-1 -rotate-12">💥</div>
      <div class="events-emoji-2 rotate-12">✊</div>

      <div class="events-icon-wrapper shadow-accent -rotate-3">
        <span
          class="material-symbols-outlined events-icon text-primary"
          style='font-variation-settings: "FILL" 1'
        >event</span>
      </div>

      <h2 class="events-title uppercase">
        <span class="highlighter-effect">Upcoming Events</span>
      </h2>

      <p class="events-desc font-typewriter">
        Join us for meetings, actions, social events, and more!
      </p>

      <a
        class="btn-primary events-cta shadow-md rotate-2 uppercase"
        href="/calendar"
      >
        View Calendar
      </a>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section container mt-xl">
      <SectionHeader
        title="Get Involved"
        subtitle="We'd love to hear from you!"
        bgColor="pink"
        rotate="-rotate-1"
        class="mb-lg"
      />

      <div class="contact-grid">
        {socialMediaItems.map((item, i) => {
          const isExternal = item.url.startsWith("http://")
            || item.url.startsWith("https://");
          const rotateClass = i % 2 === 0 ? "rotate-2" : "-rotate-2";

          return (
            <ZineCard
              as="a"
              href={item.url}
              variant="surface"
              border="medium"
              shadow="solid-md"
              rotate={rotateClass}
              class="contact-card p-md"
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
            >
              <span
                class="contact-emoji"
                aria-hidden="true"
              >{item.emoji ? item.emoji : "🔗"}</span>
              <div class="contact-info">
                <span class="contact-platform uppercase">{item.platform}</span>
                <span class="contact-label font-typewriter">
                  {item.label}
                  {isExternal && (
                    <svg
                      class="external-icon"
                      viewBox="0 0 12 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M4.5 1.5H10.5V7.5M10.5 1.5L1.5 10.5" />
                    </svg>
                  )}
                </span>
              </div>
            </ZineCard>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
/* About Section */
.about-section {
  padding-top: var(--space-xl);
  padding-bottom: var(--space-xl);
}
.about-content {
  font-family: var(--font-typewriter);
  font-size: 20px;
  color: var(--color-on-background);
  line-height: 1.625;
  max-width: 56rem;
  margin-left: auto;
  margin-right: auto;
}
.about-lead {
  font-weight: 700;
  margin-bottom: 16px;
}

/* Program Section */
.program-section {
  padding-top: var(--space-xl);
  padding-bottom: var(--space-xl);
  border-top: 4px solid var(--color-on-background);
  border-bottom: 4px solid var(--color-on-background);
}
.program-bg-overlay {
  position: absolute;
  inset: 0;
  opacity: 0.05;
  pointer-events: none;
}
.program-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-md);
}
@media (min-width: 768px) {
  .program-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }
}
.program-card-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  width: 100%;
  position: relative;
}
.program-icon {
  width: 50px;
  height: 50px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-text {
  font-size: 24px;
}
.program-title {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 900;
  color: var(--color-on-background);
  margin-bottom: 0;
}

/* Campaigns Section */
.campaigns-section {
  padding-top: var(--space-xl);
  padding-bottom: var(--space-xl);
}
.campaigns-bg-texture {
  position: absolute;
  inset: 0;
  opacity: 0.2;
  pointer-events: none;
}
.campaigns-sticker {
  position: absolute;
  top: -2rem;
  right: -1rem;
  background-color: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 20px;
  font-weight: 700;
  padding: 12px 24px;
  border: 3px solid var(--color-on-background);
  box-shadow: 4px 4px 0px 0px var(--color-on-background);
  transform: rotate(12deg);
  z-index: 20;
}
.tape-top-left {
  top: -15px;
  left: 10%;
  width: 120px;
}
.tape-top-right {
  top: -15px;
  left: 90%;
  width: 100px;
  transform: translateX(-50%) rotate(8deg);
}
.tape-bottom-center {
  bottom: -15px;
  top: auto;
  left: 50%;
  width: 150px;
  transform: translateX(-50%) rotate(-2deg);
}

.campaigns-header {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--space-xl);
  border-bottom: 4px solid var(--color-on-background);
  padding-bottom: var(--space-md);
}
@media (min-width: 640px) {
  .campaigns-header {
    flex-direction: row;
  }
}
.campaigns-title {
  font-family: var(--font-display);
  font-size: 40px;
  color: var(--color-on-background);
  font-weight: 800;
  display: inline-block;
  position: relative;
}
.campaigns-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-lg);
}
@media (min-width: 768px) {
  .campaigns-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
.campaign-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}
.campaign-card-content {
  flex-grow: 1;
}
.campaign-title {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 900;
  color: var(--color-on-background);
  margin-bottom: var(--space-xs);
}
.campaign-desc {
  font-size: 18px;
  font-weight: 700;
  color: var(--color-on-background);
}

/* Join Section */
.join-section {
  position: relative;
}
.join-banner {
  padding: var(--space-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-lg);
  position: relative;
  overflow: hidden;
}
@media (min-width: 768px) {
  .join-banner {
    flex-direction: row;
  }
}
.join-bg-dots {
  position: absolute;
  inset: 0;
  opacity: 0.4;
  pointer-events: none;
  mix-blend-mode: multiply;
}
.join-content {
  position: relative;
  z-index: 10;
  width: 100%;
}
@media (min-width: 768px) {
  .join-content {
    width: 66.666%;
  }
}
.join-title {
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: 900;
  color: var(--color-on-primary);
  margin-bottom: var(--space-md);
  line-height: 1.2;
  -webkit-text-stroke: 2px var(--color-on-background);
}
@media (min-width: 768px) {
  .join-title {
    font-size: 64px;
  }
}
.join-text {
  font-size: 20px;
  font-weight: 700;
  color: var(--color-on-primary);
  max-width: 36rem;
  line-height: 1.625;
  background-color: var(--color-on-background);
  padding: 16px;
  border: 3px solid var(--color-on-primary);
  box-shadow: 4px 4px 0px 0px var(--color-surface-lowest);
}
.join-dues {
  font-size: 18px;
  font-weight: 700;
  color: var(--color-on-primary);
  margin-top: 16px;
  background-color: #000;
  padding: 8px;
  display: inline-block;
}
.join-actions {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 16px;
  justify-content: flex-end;
  width: 100%;
  margin-top: var(--space-lg);
}
@media (min-width: 768px) {
  .join-actions {
    width: 33.333%;
    margin-top: 0;
  }
}
.join-cta {
  background-color: var(--color-accent-yellow);
  color: var(--color-on-background);
  font-size: 24px;
  padding: var(--space-lg) var(--space-xl);
  border: 4px solid var(--color-on-background);
  width: 100%;
  text-align: center;
}
.join-cta:hover {
  background-color: var(--color-surface);
  transform: scale(1.05) rotate(3deg);
}
.join-contact {
  background-color: var(--color-surface-lowest);
  color: var(--color-on-background);
  font-size: 20px;
  padding: var(--space-md) var(--space-lg);
  border: 4px solid var(--color-on-background);
  width: 100%;
  text-align: center;
}

/* Events Section */
.events-section {
  max-width: 48rem;
  margin-left: auto;
  margin-right: auto;
  padding: var(--space-xl) var(--space-gutter);
  text-align: center;
}
.tape-events {
  top: -15px;
}
.events-emoji-1 {
  position: absolute;
  top: 40px;
  left: 40px;
  font-size: 48px;
}
.events-emoji-2 {
  position: absolute;
  bottom: 80px;
  right: 40px;
  font-size: 48px;
}
.events-icon-wrapper {
  display: inline-block;
  background-color: var(--color-on-background);
  padding: 24px;
  margin-bottom: var(--space-md);
  border: 4px solid transparent;
}
.shadow-accent {
  box-shadow: 4px 4px 0px 0px var(--color-primary);
}
.events-icon {
  font-size: 64px;
}
.events-title {
  font-family: var(--font-display);
  font-size: 48px;
  color: var(--color-on-background);
  font-weight: 900;
  margin-bottom: var(--space-sm);
  display: inline-block;
  position: relative;
}
.events-desc {
  font-size: 20px;
  font-weight: 700;
  color: var(--color-on-background);
  margin-bottom: var(--space-xl);
  max-width: 32rem;
  margin-left: auto;
  margin-right: auto;
}
.events-cta {
  font-size: 20px;
  padding: 16px 32px;
  border: 4px solid var(--color-on-background);
  white-space: nowrap;
}
.events-cta:hover {
  transform: scale(1.05) rotate(2deg);
}

/* Contact Section */
.contact-section {
  padding-top: var(--space-xl);
  padding-bottom: var(--space-xl);
  border-top: 4px dashed var(--color-on-background);
}
.contact-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-lg);
}
.contact-card {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
.contact-emoji {
  font-size: 24px;
}
.contact-info {
  display: flex;
  flex-direction: column;
}
.contact-platform {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 700;
  color: var(--color-on-background);
}
.contact-label {
  font-size: 14px;
  color: var(--color-on-surface-variant);
  display: flex;
  align-items: center;
  gap: 4px;
}
.external-icon {
  width: 12px;
  height: 12px;
  opacity: 0.7;
}
</style>
