---
const pathname = Astro.url.pathname;

const aboutDropdownLinks = [
  { label: "Program", href: "/program" },
  { label: "Campaigns", href: "/#campaigns" },
  { label: "Contact", href: "/#contact" },
];

const navLinks = [
  { label: "Left Angles", href: "/leftangles" },
  { label: "Endorsements", href: "/endorsements" },
  { label: "Calendar", href: "/calendar" },
  { label: "Wiki", href: "https://wiki.dsanc.org/", external: true },
];

const ctaLink = {
  label: "Join",
  href: "https://act.dsausa.org/donate/membership/",
  external: true,
};

function isActive(href: string) {
  if (href.startsWith("/#")) return pathname === "/";
  if (href.startsWith("http")) return false;
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-container">
    <!-- Brand -->
    <a href="/" class="brand-logo uppercase">
      NC Triangle DSA
    </a>

    <!-- Desktop Nav -->
    <nav class="desktop-nav">
      <div class="nav-dropdown-group">
        <a href="/#about" class="nav-link">
          About
          <svg
            class="dropdown-icon"
            viewBox="0 0 12 12"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M2.5 4.5L6 8L9.5 4.5" />
          </svg>
        </a>
        <div class="dropdown-menu">
          {aboutDropdownLinks.map(link => (
            <a href={link.href} class="dropdown-link">{link.label}</a>
          ))}
        </div>
      </div>

      {navLinks.map((link, i) => {
        const rotateClass = i % 2 === 0 ? "rotate-right" : "rotate-left";
        const activeClass = isActive(link.href) ? "active" : "";
        return (
          <a
            href={link.href}
            class={`nav-link ${rotateClass} ${activeClass}`}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
            {link.external && (
              <svg
                class="external-icon"
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4.5 1.5H10.5V7.5M10.5 1.5L1.5 10.5" />
              </svg>
            )}
          </a>
        );
      })}
    </nav>

    <!-- CTA & Mobile Menu Toggle -->
    <div class="header-actions">
      <a
        href={ctaLink.href}
        class="btn-primary desktop-cta solid-shadow-hover"
        target={ctaLink.external ? "_blank" : undefined}
        rel={ctaLink.external ? "noopener noreferrer" : undefined}
      >
        {ctaLink.label}
      </a>
      <button id="mobile-menu-btn" class="mobile-menu-btn solid-shadow">
        <span
          class="material-symbols-outlined"
          style='font-variation-settings: "FILL" 0'
        >menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile nav overlay -->
  <nav id="mobile-menu" class="mobile-menu-overlay">
    <div class="mobile-menu-content">
      <div class="mobile-menu-section border-bottom">
        <p class="mobile-menu-label font-typewriter uppercase tracking-widest">
          About
        </p>
        <div class="mobile-menu-links indent">
          {aboutDropdownLinks.map(link => (
            <a href={link.href} class="mobile-link">{link.label}</a>
          ))}
        </div>
      </div>

      <div class="mobile-menu-links pt-md">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-link"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
            {link.external && (
              <svg
                class="external-icon-large"
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4.5 1.5H10.5V7.5M10.5 1.5L1.5 10.5" />
              </svg>
            )}
          </a>
        ))}
      </div>

      <a
        href={ctaLink.href}
        class="btn-primary mobile-cta solid-shadow-hover rotate-1"
        target={ctaLink.external ? "_blank" : undefined}
        rel={ctaLink.external ? "noopener noreferrer" : undefined}
      >
        {ctaLink.label}
      </a>
    </div>
  </nav>
</header>

<style>
.site-header {
  width: 100%;
  position: sticky;
  top: 0;
  background-color: var(--color-accent-pink);
  border-bottom: 4px solid var(--color-primary);
  z-index: 50;
  transition: background-color var(--transition-slow);
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--space-md);
  padding-bottom: var(--space-md);
}

.brand-logo {
  font-family: var(--font-display);
  font-size: 32px;
  line-height: 38px;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: -0.01em;
  transition: all var(--transition-normal);
  -webkit-text-stroke: 1px var(--color-primary);
}
@media (min-width: 1024px) {
  .brand-logo {
    font-size: 48px;
    line-height: 56px;
    letter-spacing: -0.02em;
  }
}
.brand-logo:hover {
  transform: rotate(2deg);
}
.brand-logo:active {
  transform: translateY(2px);
}

.desktop-nav {
  display: none;
  align-items: center;
  gap: var(--space-lg);
}
@media (min-width: 1024px) {
  .desktop-nav {
    display: flex;
  }
}

.nav-link {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  color: var(--color-primary);
  padding: var(--space-xs) 12px;
  border: 2px solid transparent;
  transition: all var(--transition-normal);
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.nav-link:hover,
.nav-link.active {
  background-color: var(--color-accent-yellow);
  color: var(--color-on-background);
  border-color: var(--color-primary);
}
.nav-link.rotate-right:hover {
  transform: rotate(3deg);
}
.nav-link.rotate-left:hover {
  transform: rotate(-3deg);
}

.nav-dropdown-group {
  position: relative;
}
.nav-dropdown-group:hover .nav-link {
  transform: rotate(-3deg);
}
.dropdown-icon {
  width: 16px;
  height: 16px;
  stroke: var(--color-primary);
  transition: transform var(--transition-normal);
}
.nav-dropdown-group:hover .dropdown-icon {
  transform: rotate(180deg);
}

.dropdown-menu {
  position: absolute;
  left: 0;
  top: 100%;
  margin-top: 8px;
  display: none;
  width: 12rem;
  background-color: var(--color-accent-pink);
  border: 3px solid var(--color-primary);
  box-shadow: 4px 4px 0px 0px var(--color-primary);
  padding: 8px;
  z-index: 50;
}
.dropdown-menu::before {
  content: "";
  position: absolute;
  top: -12px;
  left: 0;
  right: 0;
  height: 12px;
  background-color: transparent;
}
.nav-dropdown-group:hover .dropdown-menu {
  display: block;
}
.dropdown-link {
  display: block;
  font-family: var(--font-typewriter);
  font-size: 18px;
  font-weight: 700;
  color: var(--color-primary);
  padding: 8px 12px;
  transition: all var(--transition-fast);
}
.dropdown-link:hover {
  background-color: var(--color-accent-yellow);
  color: var(--color-primary);
}

.external-icon {
  width: 12px;
  height: 12px;
  opacity: 0.7;
}
.external-icon-large {
  width: 20px;
  height: 20px;
  opacity: 0.7;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.desktop-cta {
  display: none;
  position: relative;
}
@media (min-width: 1024px) {
  .desktop-cta {
    display: inline-flex;
  }
}
.desktop-cta:hover {
  transform: rotate(3deg) scale(1.05);
}

.mobile-menu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-sm);
  color: var(--color-primary);
  border: 3px solid var(--color-primary);
  background-color: var(--color-accent-pink);
  transition: background-color var(--transition-fast);
  cursor: pointer;
}
@media (min-width: 1024px) {
  .mobile-menu-btn {
    display: none;
  }
}
.mobile-menu-btn:hover {
  background-color: var(--color-primary);
  color: var(--color-on-primary);
}

.mobile-menu-overlay {
  position: fixed;
  inset: 0;
  top: 88px;
  background-color: var(--color-accent-pink);
  border-top: 4px solid var(--color-primary);
  z-index: 40;
  display: none;
  flex-direction: column;
  overflow-y: auto;
  padding: var(--space-gutter);
  padding-bottom: 128px;
}
.mobile-menu-overlay.is-open {
  display: flex;
}

.mobile-menu-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.mobile-menu-section.border-bottom {
  border-bottom: 3px solid var(--color-primary);
  padding-bottom: var(--space-md);
}

.mobile-menu-label {
  font-size: 20px;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: var(--space-sm);
  opacity: 0.7;
}

.mobile-menu-links {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
.mobile-menu-links.indent {
  padding-left: var(--space-md);
}
.mobile-menu-links.pt-md {
  padding-top: var(--space-md);
}

.mobile-link {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 700;
  color: var(--color-primary);
  transition: color var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.mobile-menu-links.pt-md .mobile-link {
  font-size: 30px;
}
.mobile-link:hover {
  color: var(--color-on-background);
}

.mobile-cta {
  margin-top: var(--space-xl);
  font-size: 20px;
  padding: var(--space-md) var(--space-xl);
  border-width: 4px;
  transform: rotate(1deg);
}
</style>

<script>
const toggle = document.getElementById("mobile-menu-btn");
const menu = document.getElementById("mobile-menu");
const icon = toggle?.querySelector(".material-symbols-outlined");

if (toggle && menu && icon) {
  toggle.addEventListener("click", () => {
    const isHidden = !menu.classList.contains("is-open");
    if (isHidden) {
      menu.classList.add("is-open");
      icon.textContent = "close";
      document.body.style.overflow = "hidden";
    } else {
      menu.classList.remove("is-open");
      icon.textContent = "menu";
      document.body.style.overflow = "";
    }
  });

  // Close on link click
  menu.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      menu.classList.remove("is-open");
      icon.textContent = "menu";
      document.body.style.overflow = "";
    });
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("is-open")) {
      menu.classList.remove("is-open");
      icon.textContent = "menu";
      document.body.style.overflow = "";
    }
  });
}
</script>
