---
import { sanityImageSrcset, sanityImageUrl } from "../sanity/lib/url-for-image";

const { asset, alt } = Astro.props.node;
const imgAlt = alt ?? "";
---

<figure class="portable-image">
  <img
    src={sanityImageUrl(asset, 800)}
    srcset={sanityImageSrcset(asset, [400, 800, 1200, 1600])}
    sizes="(max-width: 768px) 100vw, 740px"
    alt={imgAlt}
    loading="lazy"
    decoding="async"
    style="width: 100%; height: auto; display: block; border-radius: var(--radius-md)"
  />
</figure>
