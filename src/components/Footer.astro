---
import { sanityClient } from "sanity:client";
import { type SocialMedia } from "../sanity/schemaTypes/socialMedia";

interface Props {
  socialMediaItems?: SocialMedia[];
}

const { socialMediaItems: socialMediaFromProps } = Astro.props as Props;

const socialMediaItems = socialMediaFromProps
  ?? await sanityClient.fetch<SocialMedia[]>(
    `*[_type == "socialMedia"] | order(order asc) {
      platform,
      label,
      url,
      emoji,
      order
    }`,
  );
---

<footer class="site-footer">
  <div class="footer-bg-dots bg-dots mix-blend-screen"></div>

  <div class="footer-container container">
    <!-- Brand & Copyright -->
    <div class="footer-brand">
      <span class="footer-logo uppercase">
        <span class="footer-logo-box"></span> NC Triangle DSA
      </span>
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} NC Triangle DSA.<br />All Rights
        Reserved.<br />Not authorized by any candidate or candidate's committee.
      </p>
    </div>

    <!-- Links -->
    <div class="footer-links">
      <a class="footer-link hover-rotate-right uppercase" href="/#about"
      >About</a>
      <a class="footer-link hover-rotate-left uppercase" href="/#campaigns"
      >Campaigns</a>
      <a class="footer-link hover-rotate-left uppercase" href="/endorsements"
      >Endorsements</a>
      <a class="footer-link hover-rotate-right uppercase" href="/calendar"
      >Events</a>

      {socialMediaItems.map((item, index) => {
        const isExternal = item.url.startsWith("http://")
          || item.url.startsWith("https://");
        const rotationClass = index % 2 === 0
          ? "hover-rotate-left"
          : "hover-rotate-right";

        return (
          <a
            class={`footer-link ${rotationClass} uppercase`}
            href={item.url}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            {item.platform}
            {isExternal && (
              <svg
                class="external-icon"
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M4.5 1.5H10.5V7.5M10.5 1.5L1.5 10.5" />
              </svg>
            )}
          </a>
        );
      })}
    </div>
  </div>
</footer>

<style>
.site-footer {
  width: 100%;
  padding-top: var(--space-xl);
  padding-bottom: var(--space-lg);
  background-color: var(--color-on-background);
  margin-top: var(--space-xl);
  position: relative;
  border-top: 8px solid var(--color-primary);
}

.footer-bg-dots {
  position: absolute;
  inset: 0;
  opacity: 0.2;
  pointer-events: none;
  mix-blend-mode: screen;
}

.footer-container {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-lg);
  position: relative;
  z-index: 10;
}
@media (min-width: 768px) {
  .footer-container {
    flex-direction: row;
  }
}

.footer-brand {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  max-width: 24rem;
}

.footer-logo {
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: 900; /* black */
  color: var(--color-on-primary);
  display: flex;
  align-items: center;
  gap: 12px;
}

.footer-logo-box {
  width: 40px;
  height: 40px;
  background-color: var(--color-primary);
  border: 3px solid var(--color-on-primary);
  display: inline-block;
  transform: rotate(12deg);
}

.footer-copyright {
  font-family: var(--font-typewriter);
  font-size: 18px;
  color: var(--color-surface-dim); /* using surface-dim or surface-variant */
  margin-top: 16px;
}

.footer-links {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: var(--space-xl);
  row-gap: 24px;
}

.footer-link {
  font-family: var(--font-typewriter);
  font-size: 20px;
  font-weight: 700;
  color: var(--color-on-primary);
  transition: all var(--transition-normal);
  display: flex;
  align-items: center;
  gap: 8px;
}
.footer-link:hover {
  color: var(--color-accent-yellow);
  text-decoration: underline;
}

.hover-rotate-right:hover {
  transform: rotate(2deg);
}
.hover-rotate-left:hover {
  transform: rotate(-2deg);
}

.external-icon {
  width: 12px;
  height: 12px;
  opacity: 0.7;
}
</style>
